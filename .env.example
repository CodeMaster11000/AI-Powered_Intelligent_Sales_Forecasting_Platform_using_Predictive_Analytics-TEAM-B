# Database Configuration (PostgreSQL)
POSTGRES_USER=put_your_postgres_user
POSTGRES_PASSWORD=put_your_postgres_password
POSTGRES_DB=salesgenie
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/salesgenie

# Multi-LLM Provider Engine
# Options: auto (cascading fallback), gemini, openai, grok, ollama
PREFERRED_LLM_PROVIDER=auto

# 1. Google Gemini (Primary Enterprise Choice)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# 2. OpenAI (Secondary Choice)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 3. xAI Grok (Cutting-Edge Reasoning)
XAI_API_KEY=
GROK_MODEL=grok-2-latest

# 4. Local LLMs via Ollama (Zero-Data-Retention / Privacy First)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# CRM integrations
# HubSpot service/private-app bearer token. Never commit the value.
HUBSPOT_SERVICE_KEY=
HUBSPOT_API_BASE_URL=https://api.hubapi.com/
CRM_REQUEST_TIMEOUT=15

# Salesforce OAuth client credentials are not sufficient by themselves
# until the External Client App flow and org URL are configured.
SALESFORCE_CONSUMER_KEY=
SALESFORCE_CONSUMER_SECRET=
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_API_VERSION=v60.0
