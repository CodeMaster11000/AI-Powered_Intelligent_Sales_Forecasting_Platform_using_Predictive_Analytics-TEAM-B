        "Job Title": ["VP of Engineering", "Chief Technology Officer", "Head of Product"],
        "Industry": ["Cloud Infrastructure", "Enterprise Software", "Artificial Intelligence"],
        "Company Size": ["250-500", "51-200", "501-1000"],
