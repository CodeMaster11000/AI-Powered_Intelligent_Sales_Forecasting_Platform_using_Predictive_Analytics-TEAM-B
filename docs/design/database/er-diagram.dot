  ls [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#14284B"><TR><TD COLSPAN="3" BGCOLOR="#14284B"><FONT COLOR="white"><B>lead_scores</B>  <FONT POINT-SIZE="9">(M1)</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#444444"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#444444"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">lead_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#444444"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">score</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">int 0-100</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#444444"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">priority</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">text</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#444444"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">factors</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">jsonb</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#444444"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">reason</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">text</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#444444"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">created_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">timestamptz</FONT></TD></TR></TABLE>>];
  ci [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#14284B"><TR><TD COLSPAN="3" BGCOLOR="#14284B"><FONT COLOR="white"><B>company_insights</B>  <FONT POINT-SIZE="9">(M1)</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#444444"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#444444"><B>FK, UK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">lead_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#444444"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">summary</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">text</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#444444"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">opportunities</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">text</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#444444"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">pain_points</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">text</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#444444"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">created_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">timestamptz</FONT></TD></TR></TABLE>>];
  oe [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2F5DA8"><TR><TD COLSPAN="3" BGCOLOR="#2F5DA8"><FONT COLOR="white"><B>outreach_emails</B>  <FONT POINT-SIZE="9">(M2)</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#444444"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#444444"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">lead_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#444444"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">user_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#444444"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">subject</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">text</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#444444"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">body</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">text</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#444444"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">status</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">text</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#444444"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">created_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">timestamptz</FONT></TD></TR></TABLE>>];
  it [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F7A7A"><TR><TD COLSPAN="3" BGCOLOR="#1F7A7A"><FONT COLOR="white"><B>interactions</B>  <FONT POINT-SIZE="9">(M3)</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#444444"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#444444"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">lead_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#444444"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">user_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#444444"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">type</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">text</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#444444"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">occurred_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#444444"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">raw_notes</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">text</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#444444"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">summary</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">text</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT POINT-SIZE="9" COLOR="#444444"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">action_items</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE