digraph ER {
  graph [rankdir=LR, splines=true, nodesep=0.5, ranksep=1.3, fontname="DejaVu Sans", bgcolor="white", pad=0.3];
  node [shape=plain, fontname="DejaVu Sans"]; edge [fontname="DejaVu Sans", fontsize=10, color="#555555", arrowhead=crow, arrowtail=tee, dir=both, arrowsize=0.9];
  users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#14284B"><TR><TD COLSPAN="3" BGCOLOR="#14284B"><FONT COLOR="white"><B>Users</B>  <FONT POINT-SIZE="9">(M1)</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#444444"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="black">user_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#444444"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="black">name</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">text</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#444444"><B>UK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="black">email</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">text</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#444444"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="black">role</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">text</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#444444"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="black">department</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">text</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#444444"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="black">created_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">timestamptz</FONT></TD></TR></TABLE>>];
  leads [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#14284B"><TR><TD COLSPAN="3" BGCOLOR="#14284B"><FONT COLOR="white"><B>Leads</B>  <FONT POINT-SIZE="9">(M1)</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#444444"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="black">lead_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#B35A00"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B35A00">+ owner_user_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#444444"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="black">company_name</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">text</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#444444"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="black">industry</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">text</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#444444"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="black">contact_name</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">text</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#B35A00"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B35A00">+ contact_title</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">text</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#444444"><B>UK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="black">email</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">text</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#444444"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="black">phone</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">text</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#444444"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="black">lead_status</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">text (5 stages)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#B35A00"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B35A00">+ source</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">text (5 vectors)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#B35A00"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B35A00">+ company_size</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">text</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#B35A00"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B35A00">+ annual_revenue</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">text</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#B35A00"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B35A00">+ funding_stage</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">text</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#B35A00"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B35A00">+ funding_raised</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">text</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#B35A00"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B35A00">+ location</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">text</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#B35A00"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B35A00">+ tech_stack</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">jsonb</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#444444"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="black">created_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#B35A00"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B35A00">+ updated_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">timestamptz</FONT></TD></TR></TABLE>>];
  ci [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#14284B"><TR><TD COLSPAN="3" BGCOLOR="#14284B"><FONT COLOR="white"><B>Company_Insights</B>  <FONT POINT-SIZE="9">(M1)</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#444444"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="black">insight_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#444444"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="black">lead_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#444444"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="black">business_needs</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">text</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#444444"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="black">opportunities</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">text</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#444444"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="black">industry_analysis</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">text</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#B35A00"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B35A00">+ qualification_score</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">int</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#B35A00"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B35A00">+ growth_indicators</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">text</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#B35A00"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B35A00">+ tech_alignment</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">text</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#B35A00"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B35A00">+ decision_maker_summary</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">text</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#444444"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="black">generated_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">timestamptz</FONT></TD></TR></TABLE>>];
  ls [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2F5DA8"><TR><TD COLSPAN="3" BGCOLOR="#2F5DA8"><FONT COLOR="white"><B>Lead_Scores</B>  <FONT POINT-SIZE="9">(M2)</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#444444"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="black">score_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#444444"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="black">lead_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#444444"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="black">lead_score</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">int</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#444444"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="black">conversion_probability</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">numeric</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#444444"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="black">generated_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">timestamptz</FONT></TD></TR></TABLE>>];
  oc [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2F5DA8"><TR><TD COLSPAN="3" BGCOLOR="#2F5DA8"><FONT COLOR="white"><B>Outreach_Campaigns</B>  <FONT POINT-SIZE="9">(M2)</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#444444"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="black">campaign_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#444444"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="black">lead_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#444444"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="black">email_subject</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">text</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#444444"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="black">email_content</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">text</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#444444"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="black">campaign_status</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">text</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#444444"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="black">created_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">timestamptz</FONT></TD></TR></TABLE>>];
  si [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F7A7A"><TR><TD COLSPAN="3" BGCOLOR="#1F7A7A"><FONT COLOR="white"><B>Sales_Interactions</B>  <FONT POINT-SIZE="9">(M3)</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#444444"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="black">interaction_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#444444"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="black">lead_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#444444"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="black">interaction_type</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">text</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#444444"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="black">summary</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">text</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#444444"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="black">action_items</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">text</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#444444"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="black">interaction_date</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">timestamptz</FONT></TD></TR></TABLE>>];
  cs [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F7A7A"><TR><TD COLSPAN="3" BGCOLOR="#1F7A7A"><FONT COLOR="white"><B>CRM_Sync_Logs</B>  <FONT POINT-SIZE="9">(M3)</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#444444"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="black">sync_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#444444"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="black">lead_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#444444"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="black">crm_platform</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">text</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#444444"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="black">sync_status</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">text</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#444444"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="black">timestamp</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">timestamptz</FONT></TD></TR></TABLE>>];
  sa [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8A2B3A"><TR><TD COLSPAN="3" BGCOLOR="#8A2B3A"><FONT COLOR="white"><B>Sales_Analytics</B>  <FONT POINT-SIZE="9">(M4)</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#444444"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="black">analytics_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#444444"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="black">user_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#444444"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="black">conversion_rate</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">numeric</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#444444"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="black">pipeline_value</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">numeric</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT POINT-SIZE="9" COLOR="#444444"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="black">generated_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#777777">timestamptz</FONT></TD></TR></TABLE>>];
  users -> leads [label="owns", headlabel="N", taillabel="1", labeldistance=2.2, labelfontsize=9];
  users -> sa [label="has", headlabel="N", taillabel="1", labeldistance=2.2, labelfontsize=9];
