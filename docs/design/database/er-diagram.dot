  leads -> cs [label="audited by", headlabel="N", taillabel="1", labeldistance=2.2, labelfontsize=9];
  legend [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="0"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><B>Legend</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#B35A00">+ orange = proposed addition (not in the SRS)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">(M1-M4) = milestone where the table is built</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK primary key, FK foreign key, UK unique</FONT></TD></TR></TABLE>>];
}