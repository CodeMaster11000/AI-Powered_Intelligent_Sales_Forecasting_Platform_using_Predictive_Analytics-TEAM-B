  users -> leads [label="owns", taillabel="1", headlabel="N", labeldistance=2.2, labelfontsize=9];
  users -> oe [label="writes", taillabel="1", headlabel="N", labeldistance=2.2, labelfontsize=9];
  users -> it [label="logs", taillabel="1", headlabel="N", labeldistance=2.2, labelfontsize=9];
  leads -> ls [label="scored over time", taillabel="1", headlabel="N", labeldistance=2.2, labelfontsize=9];
