erDiagram
    USERS ||--o{ LEADS : owns
    USERS ||--o{ OUTREACH_EMAILS : writes
    USERS ||--o{ INTERACTIONS : logs
    LEADS ||--o{ LEAD_SCORES : "scored over time"
    LEADS ||--o| COMPANY_INSIGHTS : "profiled by"
    LEADS ||--o{ OUTREACH_EMAILS : receives
    LEADS ||--o{ INTERACTIONS : has

    USERS {
        bigint id PK
        text name
        text email UK
        text role
        timestamptz created_at
    }
    LEADS {
        bigint id PK
        bigint owner_id FK
        text company_name
        text industry
        text contact_name
        text contact_title
        text email UK
        text phone
        text company_size
        text location
        text funding_stage
        jsonb tech_stack
        text stage
        text source
        timestamptz created_at
        timestamptz updated_at
    }
    LEAD_SCORES {
        bigint id PK
        bigint lead_id FK
        int score
        text priority
        jsonb factors
        text reason
        timestamptz created_at
    }
    COMPANY_INSIGHTS {
        bigint id PK
        bigint lead_id FK
        text summary
        text opportunities
        text pain_points
        timestamptz created_at
    }
    OUTREACH_EMAILS {
        bigint id PK
        bigint lead_id FK
        bigint user_id FK
        text subject
        text body
        text status
        timestamptz created_at
    }
    INTERACTIONS {
        bigint id PK
        bigint lead_id FK
        bigint user_id FK
        text type
        timestamptz occurred_at
        text raw_notes
        text summary
        jsonb action_items
        timestamptz created_at
    }
